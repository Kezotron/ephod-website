# EPHOD static site — Apache rules
# (This file is saved as .htaccess when deployed.)

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
AddType image/webp .webp
AddType image/svg+xml .svg

ErrorDocument 404 /404.html

RewriteEngine On

# --- old WordPress addresses -> new pages (permanent redirects) ---
RewriteRule ^am-bible-reading/?$ /am-reading.html [R=301,L]
RewriteRule ^am-bible-reading-2/?$ /am-reading.html [R=301,L]
RewriteRule ^pm-bible-reading/?$ /pm-reading.html [R=301,L]
RewriteRule ^(am|pm)-bible-reading-(yesterday|2days|3days|4days|5days|6days|1week)/?$ /catch-up.html [R=301,L]
RewriteRule ^miss-a-day-catch-up-here/?$ /catch-up.html [R=301,L]
RewriteRule ^full-life-study-bible-reading-plan/?$ /reading-plan.html [R=301,L]
RewriteRule ^ephod-pioneers/?$ /about.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^(category/devotions|blog|devotions)(/.*)?$ /devotions.html [R=301,L]
RewriteRule ^(log-in|register|profile|reset-your-password|demo|demo-home|wp-login\.php|wp-admin.*|feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^[0-9]{4}/[0-9]{2}/?$ /devotions.html [R=301,L]

# --- devotions: every devotion has a real page at /devotion/<slug>.html (written on the server) ---
# devotion.html?slug=x -> /devotion/x.html when that page exists (permanent: the page is the address)
RewriteCond %{QUERY_STRING} ^slug=([a-z0-9-]+)$
RewriteCond %{DOCUMENT_ROOT}/devotion/%1.html -f
RewriteRule ^devotion\.html$ /devotion/%1.html? [R=301,L]
# /devotion/x.html not generated yet -> the script page (temporary, until the page is written)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^devotion/([a-z0-9-]+)\.html$ /devotion.html?slug=$1 [R=302,L]

# --- old WordPress devotion permalinks: /checkmate/ -> the devotion page ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/devotion/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /devotion/$1.html [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ /devotion.html?slug=$1 [R=301,L]

# --- keep private things private ---
RewriteRule ^(source|\.git)(/|$) - [F,L]
<FilesMatch "^(config\.php|config\.local\.php|.*\.sql|.*\.md|htaccess\.txt|\.git.*)$">
  Require all denied
</FilesMatch>
